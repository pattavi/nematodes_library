# Copy to .env and fill in. Never commit .env.
PORT=3000
# Admin password: leave empty to keep login disabled (everyone read-only).
# It is hashed in memory at startup; sessions are kept in memory (lost on restart).
ADMIN_PASSWORD=
# Minutes of inactivity before the admin session expires (default 30).
SESSION_IDLE_MIN=30
# Set to 1 when the site is served over HTTPS (adds the Secure flag to the session cookie).
COOKIE_SECURE=0
# Set to 1 when running behind a reverse proxy (nginx, Caddy, ...).
TRUST_PROXY=0
# Optional: where the database and uploaded images live (defaults: ./data/nematodes.db and ./uploads).
# DB_PATH=
# UPLOAD_DIR=
